# Copy to /etc/systemd/system/xayven-ui.service
# Edit User, WorkingDirectory, and ExecStart paths to match your setup
[Unit]
Description=Xayven UI
After=network.target

[Service]
Type=simple
# CHANGE THESE to match your user and install path:
User=YOURUSER
WorkingDirectory=/home/YOURUSER/xayven-ui
ExecStart=/home/YOURUSER/xayven-ui/venv/bin/uvicorn app:app --port 7777 --host 0.0.0.0
Restart=always
RestartSec=3
EnvironmentFile=-/home/YOURUSER/xayven-ui/.env

[Install]
WantedBy=multi-user.target

